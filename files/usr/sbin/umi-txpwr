#!/bin/sh
#
# MT7981 5G TX power 最大功率补丁
# 偏移 0x445 = MT_EE_TX0_POWER_5G_V2（20 bytes），写入 0x2B
#
F=/lib/firmware/MT7981_iPAiLNA_EEPROM.bin
[ -f "$F" ] || exit 0

SIZE=$(wc -c < "$F" 2>/dev/null || echo 0)
[ "$SIZE" -ge 1120 ] || exit 0

[ -e /etc/.umi-txpwr-applied ] && exit 0

printf '++++++++++++++++++++' > /tmp/umi-txpwr.bin
if dd if=/tmp/umi-txpwr.bin of="$F" bs=1 seek=$((0x445)) conv=notrunc 2>/dev/null; then
	sync
	touch /etc/.umi-txpwr-applied
fi
rm -f /tmp/umi-txpwr.bin
exit 0
