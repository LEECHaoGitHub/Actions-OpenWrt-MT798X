CONFIG_PACKAGE_zram-swap=y

CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y

# ---------------------------------------------------------------------------
# 代理网络基础（只服务 honk + momo）
#   honk : kmod-sched-core / sched-bpf / nft-queue / veth + v2ray-geoip/geosite
#   momo : sing-box + kmod-nft-tproxy / nft-socket / inet-diag / tun / dummy
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-masq=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-compat=y

CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-nft=y

CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-netlink-diag=y

CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-fq_codel=y

# ---------------------------------------------------------------------------
# 应用：代理（只保留 honk + momo）
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-momo=y
CONFIG_PACKAGE_momo=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# 其余代理程序全部关闭（不再编译它们的二进制与专用依赖）
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-nikki=n
CONFIG_PACKAGE_luci-app-nikki-rs=n
CONFIG_PACKAGE_luci-app-daede=n
CONFIG_PACKAGE_daed=n
CONFIG_PACKAGE_dae=n
# CONFIG_PACKAGE_luci-app-homeproxy is not set

# ---------------------------------------------------------------------------
# 应用：功能
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-firewall=y
# smartdns 会与 honk / momo 的 DNS 接管冲突，关闭；确需可自行改回 =y
# CONFIG_PACKAGE_luci-app-smartdns is not set
CONFIG_PACKAGE_luci-app-authshield=y

# 按需开启（默认关闭）
CONFIG_PACKAGE_luci-app-poweroffdevice=y
