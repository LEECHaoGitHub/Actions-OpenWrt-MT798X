# ============================================================================
#  mt7981-25.12-umi-uax3000e.config
#
#  设备   : UMI UAX3000E（eMMC 版）
#  硬件   : MediaTek MT7981B / 1GB DDR3 / 128GB eMMC / USB3.0 / WiFi6 160MHz
#  源码   : https://github.com/chasey-dev/immortalwrt-mt798x-rebase  分支 25.12
#  参考   : 24.10/mt7981-umi-uax3000e.config
#           25.12/mt7981-25.12.config
#
#  ⚠️ 重要：immortalwrt 25.12 源码本身不含 umi,uax3000e 设备。
#     必须使用 .github/workflows/25.12-umi-uax3000e.yml（会自动调用
#     25.12/umi-uax3000e/add-device.sh 注入 DTS 与设备定义），
#     否则本配置里的设备符号会被 make defconfig 丢弃，编译出错误机型的固件。
#
#  修订   : 2026-11-10 v2 → v5
#           - v2：关闭 4 个 Rust 组件（crates.io 下载失败）
#           - v4：代理只保留 luci-app-honk + luci-app-momo
#                 关闭 openclash / passwall / passwall2 / ssr-plus / nikki / daed 等
#                 以及它们专用的 iptables/ipset/QoS 依赖，精简体积与构建时间
#           - v5：去掉 tc-full，只保留默认 tc-tiny
#                 （25.12 用 apk，tc-tiny/tc-full 都 PROVIDES tc，同时安装会冲突）
#           - honk 的 honk-core 由工作流下载作者预编译包，不需要 zig/nightly Rust
#
#  固件产物：*sysupgrade.bin（sysupgrade-tar 格式）
#     刷机方式：U-Boot 网页恢复（192.168.1.1）或原厂/不死 U-Boot 的升级页面
# ============================================================================

# ---------------------------------------------------------------------------
# 目标平台 / 设备
# ---------------------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_umi_uax3000e=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_umi_uax3000e=""
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---------------------------------------------------------------------------
# 编译选项
# ---------------------------------------------------------------------------
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_BLKID=y
CONFIG_BUSYBOX_CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_BUSYBOX_CONFIG_VOLUMEID=y
# CONFIG_GDB is not set
CONFIG_INCLUDE_CONFIG=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_AFALG_UPDATE_CTR_IV=y
# CONFIG_AFALG_FALLBACK is not set
# CONFIG_PKG_CHECK_FORMAT_SECURITY is not set
# CONFIG_PKG_FORTIFY_SOURCE_1 is not set
CONFIG_PKG_FORTIFY_SOURCE_2=y
# CONFIG_OPENSSL_ENGINE_BUILTIN is not set
# CONFIG_OPENSSL_PREFER_CHACHA_OVER_GCM is not set
CONFIG_OPENSSL_WITH_NPN=y
# CONFIG_WOLFSSL_HAS_ECC25519 is not set

# ---------------------------------------------------------------------------
# 内核（25.12 / 6.12）：cgroup v2 + eBPF/BTF（daed、代理分流需要）
# ---------------------------------------------------------------------------
# CONFIG_KERNEL_BLK_DEV_THROTTLING is not set
# CONFIG_KERNEL_CFS_BANDWIDTH is not set
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_DEVMEM=y
# CONFIG_KERNEL_KEYS is not set
# CONFIG_KERNEL_MEMCG_SWAP is not set
CONFIG_KERNEL_NET_CLS_CGROUP=y

CONFIG_KERNEL_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_BPF_JIT_ALWAYS_ON=y

CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_MEMCG=y

CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_INFO_BTF=y

CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_TCP_FASTOPEN=y
CONFIG_KERNEL_NET_NS=y

# ---------------------------------------------------------------------------
# MediaTek WiFi（mt_wifi 闭源驱动 + mt7981 20260601 固件）
# ---------------------------------------------------------------------------
CONFIG_CONNINFRA_AUTO_UP=y
CONFIG_CONNINFRA_EMI_SUPPORT=y
CONFIG_MTK_ACK_CTS_TIMEOUT_SUPPORT=y
CONFIG_MTK_AIR_MONITOR=y
CONFIG_MTK_AMPDU_CONF_SUPPORT=y
CONFIG_MTK_ANTENNA_CONTROL_SUPPORT=y
CONFIG_MTK_APCLI_SUPPORT=y
CONFIG_MTK_ATE_SUPPORT=y
CONFIG_MTK_BACKGROUND_SCAN_SUPPORT=y
CONFIG_MTK_CAL_BIN_FILE_SUPPORT=y
CONFIG_MTK_CFG_SUPPORT_FALCON_MURU=y
